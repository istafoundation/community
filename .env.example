# News API Configuration
# Base URL for the News API
EXPO_PUBLIC_API_URL=https://your-api-domain.vercel.app

# API Key for authenticating with the News API
# This must match the API_SECRET_KEY set on the Vercel backend
EXPO_PUBLIC_API_KEY=your-secret-api-key-here

# Clerk Authentication Configuration
# Publishable Key from Clerk Dashboard
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
